# MongoDB Atlas
# REQUIRED for runtime, OPTIONAL for build time
# Leave empty during development if you don't need database features
# The build will succeed without MongoDB, but runtime features requiring DB will fail
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_DB=rising-dot

# Admin Credentials
# REQUIRED for admin authentication
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=your-secure-password

# Vercel Blob Storage (optional - for image uploads)
# Only needed if using Vercel Blob for media storage
BLOB_READ_WRITE_TOKEN=

# NextAuth
# REQUIRED for authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key

# OAuth Providers (optional)
# Only needed if using social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Analytics & Monitoring (optional)
# Only needed if using Google Analytics or Sentry
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
