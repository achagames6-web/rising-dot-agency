# Minimal configuration for local development
NEXTAUTH_URL=http://localhost:3000

# Site URL (change this when you deploy to your domain)
NEXT_PUBLIC_SITE_URL=https://risingdot.com
NEXTAUTH_SECRET=development-secret-key-please-change-in-production

# Admin Credentials
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=your-secure-password

# MongoDB Atlas
# Get this from MongoDB Atlas: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_DB=rising-dot

# Resend Email (for contact form)
# Sign up at: https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Cloudinary Media Storage (for image uploads)
# Sign up at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Google PageSpeed Insights API (optional)
# Get from: https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PAGESPEED_API_KEY=your_api_key_here

# Groq AI API (for Live Chat)
# Get from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Chat Notification Email
CHAT_NOTIFICATION_EMAIL=your-email@example.com

# Optional: Vercel services
# KV_URL=
# BLOB_READ_WRITE_TOKEN=